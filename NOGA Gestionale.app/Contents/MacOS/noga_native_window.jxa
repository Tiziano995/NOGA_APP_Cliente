ObjC.import('Cocoa');
ObjC.import('WebKit');

var GLOBAL_JSON_PATH = "";

ObjC.registerSubclass({
    name: 'NogaWindowDelegate',
    protocols: ['NSWindowDelegate', 'WKScriptMessageHandler'],
    methods: {
        'windowWillClose:': {
            types: ['void', ['id']],
            implementation: function(notification) {
                $.NSApp.terminate(null);
            }
        },
        'userContentController:didReceiveScriptMessage:': {
            types: ['void', ['id', 'id']],
            implementation: function(controller, message) {
                try {
                    var name = ObjC.unwrap(message.name);
                    if (name === 'nogaSaveDisk' && GLOBAL_JSON_PATH) {
                        var bodyStr = message.body;
                        bodyStr.writeToFileAtomicallyEncodingError(
                            $(GLOBAL_JSON_PATH),
                            true,
                            $.NSUTF8StringEncoding,
                            null
                        );
                    }
                } catch (e) {}
            }
        }
    }
});

function run(argv) {
    var htmlPath = argv.length > 0 ? argv[0] : "";
    var supportDir = ObjC.unwrap($.NSHomeDirectory().stringByAppendingPathComponent($("Library/Application Support/NOGA_Gestionale")));
    $.NSFileManager.defaultManager.createDirectoryAtPathWithIntermediateDirectoriesAttributesError(
        $(supportDir),
        true,
        null,
        null
    );
    GLOBAL_JSON_PATH = supportDir + "/noga_dati_persistenti.json";

    var app = $.NSApplication.sharedApplication;
    app.setActivationPolicy($.NSApplicationActivationPolicyRegular);

    // Imposta icona "NA" NOGA ROMA nel Dock
    var resourcesDir = $(htmlPath).stringByDeletingLastPathComponent.stringByDeletingLastPathComponent;
    var icnsPath = resourcesDir.stringByAppendingPathComponent($("AppIcon.icns"));
    if ($.NSFileManager.defaultManager.fileExistsAtPath(icnsPath)) {
        var iconImg = $.NSImage.alloc.initWithContentsOfFile(icnsPath);
        if (iconImg) {
            app.setApplicationIconImage(iconImg);
        }
    }

    var menubar = $.NSMenu.alloc.init;
    var appMenuItem = $.NSMenuItem.alloc.init;
    menubar.addItem(appMenuItem);
    app.setMainMenu(menubar);

    var appMenu = $.NSMenu.alloc.initWithTitle($("NOGA Gestionale"));
    var quitItem = $.NSMenuItem.alloc.initWithTitleActionKeyEquivalent(
        $("Esci da NOGA Gestionale"),
        "terminate:",
        $("q")
    );
    appMenu.addItem(quitItem);
    appMenuItem.setSubmenu(appMenu);

    var editMenuItem = $.NSMenuItem.alloc.init;
    menubar.addItem(editMenuItem);
    var editMenu = $.NSMenu.alloc.initWithTitle($("Modifica"));
    editMenu.addItemWithTitleActionKeyEquivalent($("Taglia"), "cut:", $("x"));
    editMenu.addItemWithTitleActionKeyEquivalent($("Copia"), "copy:", $("c"));
    editMenu.addItemWithTitleActionKeyEquivalent($("Incolla"), "paste:", $("v"));
    editMenu.addItemWithTitleActionKeyEquivalent($("Seleziona tutto"), "selectAll:", $("a"));
    editMenuItem.setSubmenu(editMenu);

    var screenFrame = $.NSScreen.mainScreen.visibleFrame;
    var width = Math.min(1480, screenFrame.size.width * 0.94);
    var height = Math.min(920, screenFrame.size.height * 0.92);
    var rect = $.NSMakeRect(
        screenFrame.origin.x + (screenFrame.size.width - width) / 2,
        screenFrame.origin.y + (screenFrame.size.height - height) / 2,
        width,
        height
    );

    var styleMask = $.NSWindowStyleMaskTitled |
                    $.NSWindowStyleMaskClosable |
                    $.NSWindowStyleMaskMiniaturizable |
                    $.NSWindowStyleMaskResizable;

    var window = $.NSWindow.alloc.initWithContentRectStyleMaskBackingDefer(
        rect,
        styleMask,
        $.NSBackingStoreBuffered,
        false
    );
    window.setTitle($("NOGA ROMA — Gestionale Acquisizione Clienti B2B"));
    window.setMinSize($.NSMakeSize(1024, 680));
    window.setReleasedWhenClosed(false);

    var winDelegate = $.NogaWindowDelegate.alloc.init;
    window.setDelegate(winDelegate);

    var config = $.WKWebViewConfiguration.alloc.init;
    config.userContentController.addScriptMessageHandlerName(winDelegate, $("nogaSaveDisk"));

    // Carica i dati salvati su disco in ~/Library/Application Support/NOGA_Gestionale/noga_dati_persistenti.json
    if ($.NSFileManager.defaultManager.fileExistsAtPath($(GLOBAL_JSON_PATH))) {
        var savedJson = $.NSString.stringWithContentsOfFileEncodingError(
            $(GLOBAL_JSON_PATH),
            $.NSUTF8StringEncoding,
            null
        );
        if (savedJson && ObjC.unwrap(savedJson).length > 2) {
            var diskBoot = "window.__NOGA_DISK_DB__ = " + ObjC.unwrap(savedJson) + ";";
            var diskScript = $.WKUserScript.alloc.initWithSourceInjectionTimeForMainFrameOnly(
                $(diskBoot),
                $.WKUserScriptInjectionTimeAtDocumentStart,
                false
            );
            config.userContentController.addUserScript(diskScript);
        }
    }

    var confirmScript = $.WKUserScript.alloc.initWithSourceInjectionTimeForMainFrameOnly(
        $("window.confirm = function(msg) { return true; };"),
        $.WKUserScriptInjectionTimeAtDocumentStart,
        false
    );
    config.userContentController.addUserScript(confirmScript);

    var contentBounds = window.contentView.bounds;
    var webView = $.WKWebView.alloc.initWithFrameConfiguration(
        contentBounds,
        config
    );
    webView.setAutoresizingMask($.NSViewWidthSizable | $.NSViewHeightSizable);
    window.contentView.addSubview(webView);

    var fileURL = $.NSURL.fileURLWithPath($(htmlPath));
    var dirURL = fileURL.URLByDeletingLastPathComponent;
    webView.loadFileURLAllowingReadAccessToURL(fileURL, dirURL);

    window.makeKeyAndOrderFront(null);
    app.activateIgnoringOtherApps(true);
    app.run;
}
